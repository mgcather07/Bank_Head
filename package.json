{
  "name": "bankhead-hunt-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "data:fetch": "node scripts/fetch-sources.mjs && node scripts/fetch-osm-highways.mjs && node scripts/fetch-osm-roads.mjs && node scripts/build-deer-zones.mjs",
    "data:terrain": "node --max-old-space-size=4096 scripts/build-terrain.mjs",
    "data:registry": "node scripts/build-registry.mjs",
    "data": "npm run data:fetch && npm run data:terrain && npm run data:routes && npm run data:registry",
    "deploy": "npm run build && firebase deploy --only hosting:bankhead --project rehtac-labs",
    "og": "node scripts/make-og.mjs",
    "data:routes": "node --max-old-space-size=8192 scripts/build-routes.mjs",
    "data:club": "node --max-old-space-size=4096 scripts/build-club.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.1",
    "geotiff": "^3.0.5"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-contour": "^4.0.2",
    "oxlint": "^1.88.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}