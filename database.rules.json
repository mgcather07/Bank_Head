{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "schema": {
          ".validate": "newData.isNumber()"
        },
        "profile": {
          ".validate": "newData.hasChildren(['email'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "photoURL": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "prefs": {
          "hunt": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "layers": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "workspace": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "base": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "theme": {
            ".validate": "newData.isString() && (newData.val() === 'auto' || newData.val() === 'light' || newData.val() === 'dark')"
          },
          "typeFilter": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "onboarded": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "journal": {
          "$id": {
            ".validate": "$id.length <= 60 && newData.hasChildren(['date', 'created', 'owner'])",
            "owner": {
              ".validate": "newData.val() === $uid"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "start": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "end": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "location": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "coord": {
              "0": {
                ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
              },
              "1": {
                ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
              },
              "$o": {
                ".validate": false
              }
            },
            "candidateId": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "method": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "weather": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "windObserved": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "deerSeen": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "behavior": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "harvest": {
              ".validate": "newData.isString() && (newData.val() === 'none' || newData.val() === 'buck' || newData.val() === 'doe')"
            },
            "pressure": {
              ".validate": "newData.isString() && (newData.val() === 'none' || newData.val() === 'low' || newData.val() === 'moderate' || newData.val() === 'high')"
            },
            "sign": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length <= 8000"
            },
            "predictedScore": {
              ".validate": "newData.isNumber()"
            },
            "draft": {
              ".validate": "newData.isBoolean()"
            },
            "created": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "workspace": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "pins": {
          "$id": {
            ".validate": "$id.length <= 60 && newData.hasChildren(['kind', 'coord', 'created', 'owner'])",
            "owner": {
              ".validate": "newData.val() === $uid"
            },
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(stand|sighting|rub|scrape|trail|bedding|feeding|camera|parking|harvest|saved_candidate)$/)"
            },
            "coord": {
              "0": {
                ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
              },
              "1": {
                ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
              },
              "$o": {
                ".validate": false
              }
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "created": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "candidateId": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "workspace": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "lands": {
          "$id": {
            ".validate": "$id.length <= 60 && newData.hasChildren(['name', 'geometryJson', 'pack', 'deerZone'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "kind": {
              ".validate": "newData.isString() && (newData.val() === 'club' || newData.val() === 'lease' || newData.val() === 'private')"
            },
            "pack": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "deerZone": {
              ".validate": "newData.isString() && (newData.val() === 'C' || newData.val() === 'D')"
            },
            "county": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "geometryJson": {
              ".validate": "newData.isString() && newData.val().length <= 400000"
            },
            "acres": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "source": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "created": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "clubs": {
          "$clubId": {
            ".validate": "$clubId.length <= 60 && newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "provision": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $emailKey",
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $emailKey && !newData.exists()"
      }
    },
    "clubs": {
      "$clubId": {
        ".read": "auth != null && data.child('members/' + auth.uid).exists()",
        "info": {
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "kind": {
            ".validate": "newData.isString() && (newData.val() === 'club' || newData.val() === 'lease' || newData.val() === 'private')"
          },
          "pack": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "deerZone": {
            ".validate": "newData.isString() && (newData.val() === 'C' || newData.val() === 'D')"
          },
          "county": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "geometryJson": {
            ".validate": "newData.isString() && newData.val().length <= 400000"
          },
          "acres": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "source": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'owner'",
          ".validate": "newData.hasChildren(['name', 'geometryJson', 'pack', 'deerZone'])"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (($uid !== auth.uid && data.exists() && data.child('role').val() !== 'owner' && newData.child('role').val() !== 'owner' && (root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'owner' || (root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'admin' && data.child('role').val() === 'member' && (!newData.exists() || newData.child('role').val() === 'member')))) || ($uid === auth.uid && data.exists() && !newData.exists() && data.child('role').val() !== 'owner') || ($uid === auth.uid && !data.exists() && newData.exists() && auth.token.email_verified === true && root.child('clubs/' + $clubId + '/invites/' + auth.token.email.toLowerCase().replace('.', ',') + '/role').val() === newData.child('role').val()) || ($uid === auth.uid && data.exists() && newData.exists() && newData.child('role').val() === data.child('role').val()))",
            ".validate": "newData.hasChildren(['role', 'joined'])",
            "role": {
              ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'admin' || newData.val() === 'member')"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "photoURL": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "invites": {
          "$emailKey": {
            ".write": "auth != null && ((root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'owner' && data.child('role').val() !== 'owner') || (root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'admin' && data.child('role').val() !== 'admin' && (!newData.exists() || newData.child('role').val() === 'member')) || ($emailKey === auth.token.email.toLowerCase().replace('.', ',') && !newData.exists()))",
            ".validate": "$emailKey.length <= 200 && newData.hasChildren(['email', 'role', 'invitedBy', 'created'])",
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "role": {
              ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'member')"
            },
            "invitedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "invitedByName": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "created": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "invites": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $emailKey",
        "$clubId": {
          ".write": "auth != null && (root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'owner' || (root.child('clubs/' + $clubId + '/members/' + auth.uid + '/role').val() === 'admin' && (!newData.exists() || newData.child('role').val() === 'member')) || ($emailKey === auth.token.email.toLowerCase().replace('.', ',') && !newData.exists()))",
          ".validate": "newData.hasChildren(['clubName', 'role', 'invitedByName', 'created'])",
          "clubName": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "role": {
            ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'member')"
          },
          "invitedByName": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
